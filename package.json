{
  "name": "dsh-prism",
  "version": "1.14.1",
  "description": "DSH 界面三档模式（原生/整洁/白话）：整洁档走产品原版行语言，白话档走大白话，工具调用按 step 分段归组折叠 / Three-tier UI mode (native/tidy/plain) for DeepSeek Harness: the product's own row language or plain speech, with step-segmented tool groups",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "private": true,
  "dsh": {
    "client": {
      "inject": [],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1 || ^0.1.5-alpha.1"
  }
}
