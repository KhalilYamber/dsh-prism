{
  "name": "dsh-prism",
  "version": "1.3.0",
  "description": "DSH 界面三档模式（原生/中级/简化）：中级走产品原版行语言，简化走白话文案，工具调用归组折叠 / Three-tier UI mode (native/medium/simple) for DeepSeek Harness: the product's own row language or plain speech, with grouped tool calls",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "private": true,
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
